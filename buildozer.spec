[app]
title = My 3D Game
package.name = my3dgame
package.domain = org.game
source.dir = .
source.include_exts = py,png,jpg,kv,atlas,ttf,obj
requirements = python3,pygame
orientation = landscape
fullscreen = 1
android.permissions = INTERNET
android.archs = arm64-v8a

[buildozer]
log_level = 2
warn_on_root = 1
